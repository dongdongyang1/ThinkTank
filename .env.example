# ==================== MinerU PDF 解析 ====================
MINERU_API_TOKEN=your_mineru_api_token
MINERU_BASE_URL=https://mineru.example.com

# ==================== MinIO 对象存储 ====================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=thinktank
MINIO_IMG_DIR=kb_images

# ==================== Milvus 向量数据库 ====================
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# ==================== LLM 大模型 ====================
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_llm_api_key
LLM_DEFAULT_MODEL=qwen-plus
VL_MODEL=qwen-vl-plus
ITEM_MODEL=qwen-plus
LLM_DEFAULT_TEMPERATURE=0.7

# ==================== Embedding 向量模型 ====================
BGE_M3_PATH=./models/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
EMBEDDING_DIM=1024

# ==================== MCP 服务 ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== Reranker 重排序 ====================
TEXT_RERANK_MODEL=your_reranker_model
TEXT_RERANK_INSTRUCT=your_reranker_instruct

# ==================== Celery / Redis ====================
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== 文件存储 ====================
DATA_BASED_ROOT_DIR=./data
FILE_DIR=./data/uploads
